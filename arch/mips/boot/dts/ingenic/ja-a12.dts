/dts-v1/;

#include "t23.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "Jooan JA-A12 (Ingenic T23N)";
	compatible = "jooan,ja-a12", "ingenic,t23";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
	};

	chosen {
		bootargs = "earlycon console=ttyS1,115200n8 loglevel=7";
		stdout-path = "serial1:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x04000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		camera_reserved: camera@2800000 {
			compatible = "shared-dma-pool";
			reg = <0x02800000 0x01800000>;
			reusable;
			linux,cma-default;
		};
	};

	illumination {
		compatible = "gpio-leds";

		led-white {
			label = "white:illumination";
			gpios = <&gpb 28 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-infrared {
			label = "ir:illumination";
			gpios = <&gpb 27 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "Reset";
			gpios = <&gpb 30 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	wifi_pwr: wifi-regulator {
		compatible = "regulator-fixed";
		regulator-name = "wifi_power";
		gpio = <&gpa 6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	speaker_amp: speaker-amplifier {
		compatible = "simple-audio-amplifier";
		enable-gpios = <&gpb 31 GPIO_ACTIVE_LOW>;
		sound-name-prefix = "Speaker Amp";
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "ja-a12-audio";
		#address-cells = <1>;
		#size-cells = <0>;

		simple-audio-card,widgets =
			"Speaker", "Speaker",
			"Microphone", "Mic";
		simple-audio-card,routing =
			"Speaker Amp INL", "LOUT",
			"Speaker Amp INR", "ROUT",
			"Speaker", "Speaker Amp OUTL",
			"Speaker", "Speaker Amp OUTR",
			"MICIN", "Mic";

		simple-audio-card,aux-devs = <&speaker_amp>;

		simple-audio-card,dai-link@0 {
			reg = <0>;
			format = "i2s";
			bitclock-master = <&sound_codec>;
			frame-master = <&sound_codec>;

			cpu {
				sound-dai = <&aic>;
			};

			sound_codec: codec {
				sound-dai = <&codec 0>;
			};
		};

		simple-audio-card,dai-link@1 {
			reg = <1>;

			cpu {
				sound-dai = <&aic_loop>;
			};

			codec {
				sound-dai = <&codec 1>;
			};
		};
	};

	motor {
		compatible = "ingenic,t23-motor";
		pan-gpios = <&gpb 22 GPIO_ACTIVE_HIGH>,
			    <&gpb 21 GPIO_ACTIVE_HIGH>,
			    <&gpb 20 GPIO_ACTIVE_HIGH>,
			    <&gpb 19 GPIO_ACTIVE_HIGH>;
		switch-gpios = <&gpa 17 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&pinctrl {
	status = "okay";
};

&gpb {
	gpio-line-names = "", "", "", "", "", "", "", "",
			  "", "", "", "", "", "", "", "",
			  "", "ircut-out", "ircut-in";
};

&ost {
	status = "okay";
};

&tcu {
	status = "okay";
};

&pwm {
	status = "okay";
};

&watchdog {
	status = "okay";
};

&pdma {
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart1_b>;
	status = "okay";
};

&sfc {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_sfc>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		label = "jz_sfc";
		spi-max-frequency = <50000000>;
		spi-rx-bus-width = <2>;
		spi-tx-bus-width = <2>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x000000 0x040000>;
			};

			partition@40000 {
				label = "bootenv";
				reg = <0x040000 0x008000>;
			};

			partition@48000 {
				label = "kernel";
				reg = <0x048000 0x200000>;
			};

			partition@248000 {
				label = "rootfs";
				reg = <0x248000 0x300000>;
			};

			partition@548000 {
				label = "overlay";
				reg = <0x548000 0x2b8000>;
			};
		};
	};
};

&msc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_mmc0>;
	bus-width = <4>;
	max-frequency = <25000000>;
	cd-gpios = <&gpb 29 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&otg_phy {
	status = "okay";
};

&otg {
	status = "okay";
};

&aic {
	status = "okay";
};

&aic_loop {
	status = "okay";
};

&codec {
	status = "okay";
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c0>;
	clock-frequency = <100000>;
	status = "okay";

	sensor@30 {
		compatible = "smartsens,sc1a4t";
		reg = <0x30>;
		clocks = <&cgu CLK_CGU_CIM>;
		clock-names = "xvclk";
		pwdn-gpios = <&gpa 18 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpa 16 GPIO_ACTIVE_LOW>;
		smartsens,secondary-i2c-addr = <0x32>;

		port {
			sensor0_out: endpoint {
				remote-endpoint = <&isp_in0>;
				clock-lanes = <0>;
				data-lanes = <1>;
				link-frequencies = /bits/ 64 <360000000>;
			};
		};
	};

	sensor@32 {
		compatible = "smartsens,sc1a4t";
		reg = <0x32>;
		clocks = <&cgu CLK_CGU_CIM>;
		clock-names = "xvclk";
		smartsens,frame-sync-slave;

		port {
			sensor1_out: endpoint {
				remote-endpoint = <&isp_in1>;
				clock-lanes = <0>;
				data-lanes = <1>;
				link-frequencies = /bits/ 64 <360000000>;
			};
		};
	};
};

&isp {
	assigned-clocks = <&cgu CLK_CGU_ISP>;
	assigned-clock-parents = <&cgu CLK_SCLKA>;
	assigned-clock-rates = <240000000>;
	memory-region = <&camera_reserved>;
	ingenic,frame-sync-source-port = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pins_vic_switch &pins_cim_mclk>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			isp_in0: endpoint {
				remote-endpoint = <&sensor0_out>;
				clock-lanes = <0>;
				data-lanes = <1>;
			};
		};

		port@1 {
			reg = <1>;
			isp_in1: endpoint {
				remote-endpoint = <&sensor1_out>;
				clock-lanes = <0>;
				data-lanes = <1>;
			};
		};
	};
};

&ipu {
	memory-region = <&camera_reserved>;
	status = "okay";
};

&helix {
	assigned-clocks = <&cgu CLK_CGU_VPU>;
	assigned-clock-rates = <450000000>;
	memory-region = <&camera_reserved>;
	status = "okay";
};

&aes {
	status = "okay";
};

&dtrng {
	status = "okay";
};

&sadc {
	status = "okay";
};
