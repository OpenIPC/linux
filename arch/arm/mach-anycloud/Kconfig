# Machine support

config MACH_AK39EV330
	bool "anycloudv500 ak39ev330 support"
	depends on ARCH_AK
	help
	  Support for ak39ev330

config MACH_AK3918EV200
	bool "AK3918EV200 support"
	depends on ARCH_AK
	help
	  Support for the AK3918EV200 SoC variant.

config AK_OPENIPC_DTB
	string "Device tree appended to the uImage"
	depends on ARCH_AK
	default "ak3918ev200-demb" if MACH_AK3918EV200
	default "ak3918ev300-demb"
	help
	  Name, without .dtb, of the blob arch/arm/boot/Makefile appends to
	  the zImage to make the uImage (CONFIG_ARM_APPENDED_DTB). One
	  machine covers boards that differ only in memory: ak3918ev300-demb
	  for the 64 MB EV300/EV330 parts, ak3918ev331-demb for the 128 MB
	  EV331 ones.

config CPU_AK3918EV200
	bool
	default y if MACH_AK3918EV200
	help
	  Selects the AK3918EV200 variants of the ISP2 register layout, the
	  ISP attribute structures and the frame-buffer enable sequence.
	  Set by MACH_AK3918EV200; not user-selectable.
