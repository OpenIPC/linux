# Machine support

config MACH_AK37D
	bool "anycloudv500 ak37d support"
	depends on ARCH_AK
	help
	  Support for ak37d

config MACH_AK39EV330
	bool "anycloudv500 ak39ev330 support"
	depends on ARCH_AK
	help
	  Support for ak39ev330

config MACH_AK37E
	bool "anycloudv500 ak37e support"
	depends on ARCH_AK
	help
		Support for ak37e


config MACH_AK3918AV100
	bool "anycloudv500 AK3918AV100 support"
	depends on ARCH_AK
	select MULTI_IRQ_HANDLER
	help
		Support for AK3918AV100

config MACH_AK3918AV100_FPGA
	bool "anycloudv500 AK3918AV100 fpga support"
	depends on MACH_AK3918AV100
	help
		Support for AK3918AV100 fpga

config MACH_AK3918EV300L
	bool "anycloud AK3918EV300L support"
	depends on ARCH_AK
	select MULTI_IRQ_HANDLER
	help
		Support for AK3918EV300L

config AK_OPENIPC_DTB
	string "Device tree appended to the uImage"
	depends on ARCH_AK
	default "ak3918ev300l-demb" if MACH_AK3918EV300L
	default "ak3918av100-demb" if MACH_AK3918AV100
	default ""
	help
	  Name, without .dtb, of the blob arch/arm/boot/Makefile appends to
	  the zImage to make the uImage (CONFIG_ARM_APPENDED_DTB), as
	  OpenIPC's NOR images boot it: ak3918av100-demb for the 64 MB
	  AK3918AV100N/P and KM01N, ak3918av100x-demb for the 128 MB
	  AK3918AV100X/XP and KM01D, ak3918ev300l-demb for the AK3918EV300L,
	  or a camera's own board. Empty: the plain zImage, as the SDK boots
	  it with its DTB partition.
