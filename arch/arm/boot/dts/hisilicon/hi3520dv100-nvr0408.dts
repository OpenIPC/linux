// SPDX-License-Identifier: (GPL-2.0-or-later OR MIT)
/*
 * Juan NVR0408 4-channel NVR board (PCB HI3520D_V318P3_NVR0408), sold as the
 * Night Owl WNVR-20B-4: Hi3520D V100 (SC_SYSID 0x3520D100), 256 MiB DDR2 and
 * 16 MiB SPI NOR on chip select 1.
 */

/dts-v1/;
#include "hi3520dv100.dtsi"

/ {
	model = "Juan NVR0408 (Night Owl WNVR-20B-4, Hi3520D V100)";
	compatible = "juan,nvr0408", "hisilicon,hi3520dv100";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x10000000>;
	};
};

&uart0 {
	status = "okay";
};

/* The alarm is wired to the interrupt controller and wakes the SoC from standby */
&rtc {
	wakeup-source;
	status = "okay";
};

/*
 * 16 MiB flash on CS1, nothing on CS0. It takes the label the bootloader
 * names in mtdparts=, and no fixed partitions are given: the bootloader's
 * command line is the layout.
 */
&sfc {
	status = "okay";
	/*
	 * 112.5 MHz, so the SPI clock is 56.25 MHz: above the 50 MHz of the
	 * plain 03h read of the MX25L12835F. spi-nor reads with the fast read
	 * opcodes of the SFDP tables (see the bus widths of the flash), keep
	 * them when changing the flash or the bus widths.
	 */
	assigned-clock-parents = <&crg HI3520DV100_FIXED_112P5M>;

	flash@1 {
		compatible = "jedec,spi-nor";
		reg = <1>;
		label = "hi_sfc";
		/*
		 * The rating of the 1-2-2 read of the MX25L12835F, the slowest
		 * fast read the node selects. The controller cannot divide its
		 * clock, so this does not lower the 56.25 MHz SPI clock: the
		 * driver only warns if that clock ever exceeds it.
		 */
		spi-max-frequency = <84000000>;
		spi-rx-bus-width = <2>;
		spi-tx-bus-width = <2>;

		/*
		 * The factory data page (MAC address, sticker ID, Wi-Fi credentials)
		 * is at 0x7b000. The cell is described on the flash itself, at its
		 * absolute offset, and not on a partition: the whole flash stays one
		 * MTD device whatever partitions the bootloader's "mtdparts=" gives
		 * (CONFIG_MTD_PARTITIONED_MASTER), so the cell exists with or without
		 * a command line layout. Linux does not write the page.
		 */
		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			eth_mac: mac-address@7b4a8 {
				reg = <0x7b4a8 6>;
			};
		};
	};
};

/*
 * The RJ45 is on the up port through the SoC's internal PHY, in MII. The
 * PHY's address is not strapped: the MDIO driver writes this one into its
 * control register.
 */
&mdio {
	status = "okay";

	phy_up: ethernet-phy@3 {
		reg = <3>;
	};
};

&eth_up {
	/* A "local-mac-address" from the bootloader wins over the cell */
	nvmem-cells = <&eth_mac>;
	nvmem-cell-names = "mac-address";
	phy-handle = <&phy_up>;
	phy-mode = "mii";
	status = "okay";
};

&sata {
	status = "okay";
};

/* SMSC USB2514 hub and RTL8188EUS behind the EHCI, OHCI is the companion */
&ehci {
	status = "okay";
};

&ohci {
	status = "okay";
};

&usb_phy {
	status = "okay";
};
