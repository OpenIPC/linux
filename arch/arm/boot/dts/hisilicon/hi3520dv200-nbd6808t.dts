/*
 * XiongMai NBD6808T-PL NVR (MBD0157 board), Hi3520DV200, 8 MB SPI NOR.
 */

/dts-v1/;
#include "hi3520dv200.dtsi"

/ {
	model = "XiongMai NBD6808T-PL (Hi3520DV200)";
	compatible = "xiongmai,nbd6808t-pl", "hisilicon,hi3520dv200";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x08000000>;
	};
};

&uart0 {
	status = "okay";
};

/* The RJ45 is on the up port, through the SoC's internal PHY at address 3. */
&mdio {
	status = "okay";

	phy_up: ethernet-phy@3 {
		reg = <3>;
	};
};

&eth_up {
	phy-handle = <&phy_up>;
	phy-mode = "mii";
	status = "okay";
};

/*
 * 8 MB MX25L6406E on CS1. Read-only for now: the stock firmware is still on
 * it, laid out as the vendor bootargs describe.
 */
&sfc {
	status = "okay";

	flash@1 {
		compatible = "jedec,spi-nor";
		reg = <1>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x000000 0x030000>;
				read-only;
			};
			partition@30000 {
				label = "romfs";
				reg = <0x030000 0x1f0000>;
				read-only;
			};
			partition@220000 {
				label = "usr";
				reg = <0x220000 0x3b0000>;
				read-only;
			};
			partition@5d0000 {
				label = "custom";
				reg = <0x5d0000 0x1a0000>;
				read-only;
			};
			partition@770000 {
				label = "logo";
				reg = <0x770000 0x010000>;
				read-only;
			};
			partition@780000 {
				label = "mtd";
				reg = <0x780000 0x080000>;
				read-only;
			};
			/* the whole chip, for verifying it against a backup */
			partition@0-all {
				label = "all";
				reg = <0x000000 0x800000>;
				read-only;
			};
		};
	};
};

/*
 * The vendor firmware's PHY value; with the Hi3520D reference one this
 * board's link keeps resetting.
 */
&sata {
	hisilicon,phy-config = <0x0e262709>;
	status = "okay";
};

&ohci {
	status = "okay";
};

&ehci {
	status = "okay";
};
