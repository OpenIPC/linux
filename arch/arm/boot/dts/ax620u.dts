	};

	thermal-zones {

		soc_thm {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x64>;
			sustainable-power = <0x1194>;
			thermal-sensors = <0x0a 0x00>;

			trips {

				trip-point@0 {
					temperature = <0x13880>;
					hysteresis = <0x00>;
					type = "passive";
				};

				trip-point@1 {
					temperature = <0x15f90>;
					hysteresis = <0x00>;
					type = "passive";
				};

				soc-crit {
					temperature = <0x1d4c0>;
					hysteresis = <0x00>;
					type = "passive";
