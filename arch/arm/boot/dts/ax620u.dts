			panel-exit-seq = <0x5000128>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x15>;
						phandle = <0x12>;
					};
				};
			};

			display-timings {

				timing0 {
					clock-frequency = <0xcdfe60>;
