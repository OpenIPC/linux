			port@1 {
				reg = <0x01>;

				endpoint {
					remote-endpoint = <0x13>;
					phandle = <0x0e>;
				};
			};
		};

		panel_dsi0@0 {
			compatible = "axera,simple-dsi-panel";
			reg = <0x00>;
			reset-gpio = <0x14 0x03 0x00>;
			prepare-delay-ms = <0x00>;
			unprepare-delay-ms = <0x00>;
			enable-delay-ms = <0x00>;
			disable-delay-ms = <0x00>;
			reset-low-delay-ms = <0x14>;
			reset-high-delay-ms = <0x64>;
			dsi,format = <0x00>;
			dsi,lanes = <0x02>;
			dsi,flags = <0x805>;
