/dts-v1/;

/ {
	compatible = "axera,ax620x";
	interrupt-parent = <0x01>;
	#address-cells = <0x01>;
	#size-cells = <0x01>;

	aliases {
		serial0 = "/soc/dw_uart@4990000";
		serial1 = "/soc/dw_uart@4992000";
		serial2 = "/soc/dw_uart@0x04994000";
		serial3 = "/soc/dw_uart@0x04995000";
		serial4 = "/soc/dw_uart@0x04996000";
		spi0 = "/soc/apb-spi0-master@0x04998000";
		spi1 = "/soc/apb-spi1-master@0x0499A000";
		spi2 = "/soc/apb-spi2-master@0x0499C000";
		spi3 = "/soc/apb-spi3-slv@0x0499E000";
		spi4 = "/soc/spi-master@0x08000000";
		i2c0 = "/soc/i2c@4980000";
		i2c1 = "/soc/i2c@4982000";
		i2c2 = "/soc/i2c@4984000";
		i2c3 = "/soc/i2c@4986000";
		i2c4 = "/soc/i2c@4988000";
		i2c5 = "/soc/i2c@498a000";
		i2c6 = "/soc/i2c@49b0000";
		i2c7 = "/soc/i2c@49b2000";
		i2c8 = "/soc/i2c@49b4000";
		i2c9 = "/soc/i2c@49b6000";
		ethernet0 = "/ethernet@0x4970000";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		secondary-boot-reg = <0x2220300>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x00>;
			enable-method = "axera,ax620x-smp";
			operating-points = <0x5dc0 0xbe6e0 0xc3500 0xbe6e0 0xf4240 0xbe6e0 0x1220a0 0xbe6e0 0x130b00 0xbe6e0>;
			clocks = <0x02 0x01>;
			clock-names = "core-clk";
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x01>;
			enable-method = "axera,ax620x-smp";
			operating-points = <0x5dc0 0xbe6e0 0xc3500 0xbe6e0 0xf4240 0xbe6e0 0x1220a0 0xbe6e0 0x130b00 0xbe6e0>;
			clocks = <0x02 0x01>;
			clock-names = "core-clk";
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x02>;
			enable-method = "axera,ax620x-smp";
			operating-points = <0x5dc0 0xbe6e0 0xc3500 0xbe6e0 0xf4240 0xbe6e0 0x1220a0 0xbe6e0 0x130b00 0xbe6e0>;
			clocks = <0x02 0x01>;
			clock-names = "core-clk";
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x03>;
			enable-method = "axera,ax620x-smp";
			operating-points = <0x5dc0 0xbe6e0 0xc3500 0xbe6e0 0xf4240 0xbe6e0 0x1220a0 0xbe6e0 0x130b00 0xbe6e0>;
			clocks = <0x02 0x01>;
			clock-names = "core-clk";
		};
	};

	interrupt-controller@1850000 {
		compatible = "arm,cortex-a7-gic";
		#interrupt-cells = <0x03>;
		interrupt-controller;
		reg = <0x1851000 0x1000 0x1852000 0x2000 0x1854000 0x2000 0x1856000 0x2000>;
		phandle = <0x01>;
	};

	npu_reg {
		compatible = "generic-uio";
		reg = <0x3800000 0x7000>;
		status = "okay";
		interrupt-controller;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x24 0x04>;
	};

	npu_ocm {
		compatible = "generic-uio";
		reg = <0x3000000 0x500000>;
		status = "okay";
		interrupt-controller;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x27 0x01>;
	};

	npu_top {
		compatible = "generic-uio";
		status = "okay";
		interrupt-controller;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x25 0x01>;
	};

	npu_fab {
		compatible = "generic-uio";
		status = "okay";
		interrupt-controller;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x26 0x01>;
	};

	ax_npu@0x3800000 {
		compatible = "axera,npu";
		reg = <0x3800000 0x7000 0x3000000 0x500000>;
		status = "okay";
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x24 0x04 0x00 0x27 0x01 0x00 0x25 0x01 0x00 0x26 0x01>;
	};

	timer {
		compatible = "arm,armv7-timer";
		arm,cpu-registers-not-fw-configured;
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
		clock-frequency = <0x16e3600>;
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "simple-bus";
		ranges;

		ap_clk@49BA000 {
			compatible = "axera,ax620x-ap-clk", "syscon";
			reg = <0x49ba000 0x2000>;
			#clock-cells = <0x01>;
			phandle = <0x04>;
		};

		common_clk@2220000 {
			compatible = "axera,ax620x-common-clk", "syscon";
			reg = <0x2220000 0x10000>;
			#clock-cells = <0x01>;
			phandle = <0x09>;
		};

		dispc_clk@44B0000 {
			compatible = "axera,ax620x-dispc-clk", "syscon";
			reg = <0x44b0000 0x10000>;
			#clock-cells = <0x01>;
			phandle = <0x10>;
		};

		flash_clk@10030000 {
			compatible = "axera,ax620x-flash-clk", "syscon";
			reg = <0x10030000 0x10000>;
			#clock-cells = <0x01>;
			phandle = <0x05>;
		};

		isp_clk@2500000 {
			compatible = "axera,ax620x-isp-clk", "syscon";
			reg = <0x2500000 0x80000>;
			#clock-cells = <0x01>;
			phandle = <0x03>;
		};

		mm_clk@4430000 {
			compatible = "axera,ax620x-mm-clk", "syscon";
			reg = <0x4430000 0x10000>;
			#clock-cells = <0x01>;
			phandle = <0x0c>;
		};

		vpu_clk@4030000 {
			compatible = "axera,ax620x-vpu-clk", "syscon";
			reg = <0x4030000 0x10000>;
			#clock-cells = <0x01>;
			phandle = <0x17>;
		};

		cpu_clk@1900000 {
			compatible = "axera,ax620x-cpu-clk", "syscon";
			reg = <0x1900000 0x10000>;
			#clock-cells = <0x01>;
			phandle = <0x02>;
		};

		sys {
			compatible = "axera,sys";
		};

		avs {
			compatible = "axera,avs";
		};

		ax620-cpufreq@0 {
			compatible = "ax620,cpufreq";
		};

		ives@0 {
			compatible = "axera,ives";
		};

		isp@2400000 {
			compatible = "axera,proton";
			reg = <0x2400000 0x100000>;
			interrupts = <0x00 0x1b 0x04>;
			interrupt-names = "isp";
			clocks = <0x03 0x06 0x03 0x0d 0x03 0x0c 0x03 0x0b 0x03 0x0a 0x03 0x09 0x03 0x08>;
			clock-names = "isp_glb_clk", "sns_mclk0", "sns_mclk1", "sns_mclk2", "sns_mclk3", "sns_mclk4", "sns_mclk5";
		};

		isp@2600000 {
			compatible = "axera,mipi";
			reg = <0x2600000 0x2210000>;
			interrupts = <0x00 0x1d 0x04 0x00 0x1f 0x04 0x00 0x21 0x04 0x00 0x23 0x04 0x00 0x16 0x04 0x00 0x17 0x04>;
			interrupt-names = "mipi";
		};

		dw_dmac@1920000 {
			compatible = "axera,axi-dma-1.01a";
			reg = <0x1920000 0x10000>;
			#dma-cells = <0x01>;
			dma-channels = <0x02>;
			snps,dma-masters = <0x02>;
			snps,data-width = <0x02>;
			snps,block-size = <0x400000 0x400000>;
			snps,priority = <0x01 0x01>;
			snps,axi-max-burst-len = <0x100>;
			clocks = <0x02 0x02>;
			clock-names = "core-clk";
			interrupts = <0x00 0x05 0x04>;
			status = "okay";
		};

		dw_apb_timer@49a0000 {
			compatible = "axera,dw-apb-timer";
			reg = <0x49a0000 0x1000>;
			interrupts = <0x00 0x48 0x04>;
			status = "okay";
		};

		dw_apb_tmrpwm0@49a6000 {
			compatible = "axera,dw_apb_tmrpwm0";
			reg = <0x49a6000 0x1000>;
			interrupts = <0x00 0x54 0x04>;
			status = "okay";
		};

		dw_dmac_hal@0000000 {
			compatible = "axera,axi-dma-hal-1.01a";
			#dma-cells = <0x01>;
			dma-channels = <0x02>;
			status = "okay";
		};

		dw_uart@4990000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x4990000 0x1000>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			clocks = <0x04 0x5f>;
			clock-names = "baudclk";
			interrupts = <0x00 0x44 0x04>;
			status = "okay";
		};

		dw_uart@4992000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x4992000 0x1000>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			clocks = <0x04 0x5e>;
			clock-names = "baudclk";
			interrupts = <0x00 0x45 0x04>;
			status = "disabled";
		};

		dw_uart@0x04994000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x4994000 0x400>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			clocks = <0x04 0x5d>;
			clock-names = "baudclk";
			interrupts = <0x00 0x46 0x04>;
			status = "disabled";
		};

		dw_uart@0x04995000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x4995000 0x400>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			clocks = <0x04 0x5d>;
			clock-names = "baudclk";
			interrupts = <0x00 0x46 0x04>;
			status = "disabled";
		};

		dw_uart@0x04996000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x4996000 0x1000>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			clocks = <0x04 0x5c>;
			clock-names = "baudclk";
			interrupts = <0x00 0x47 0x04>;
			status = "disabled";
		};

		sdhc@0x10000000 {
			compatible = "axera,sdhc-ax620";
			reg = <0x10000000 0x10000>;
			interrupts = <0x00 0x09 0x04>;
			#size-cells = <0x02>;
			status = "disabled";
			max-frequency = <0xbebc200>;
			sdhci-caps-mask = <0x02 0x3200000>;
			bus-width = <0x08>;
			no-sdio;
			no-sd;
			non-removable;
			disable-wp;
			cap-mmc-highspeed;
			mmc-hs200-1_8v;
			mmc-hs400-1_8v;
			mmc-hs400-enhanced-strobe;
			cdns,phy-input-delay-sd-highspeed = <0x02>;
			cdns,phy-input-delay-legacy = <0x04>;
			cdns,phy-input-delay-sd-uhs-sdr12 = <0x01>;
			cdns,phy-input-delay-sd-uhs-sdr25 = <0x02>;
			cdns,phy-input-delay-sd-uhs-sdr50 = <0x01>;
			cdns,phy-input-delay-sd-uhs-ddr50 = <0x02>;
			cdns,phy-input-delay-mmc-legacy = <0x01>;
			cdns,phy-input-delay-mmc-highspeed = <0x02>;
			cdns,phy-input-delay-mmc-ddr = <0x02>;
			cdns,phy-dll-delay-sdclk = <0x2d>;
			cdns,phy-dll-delay-sdclk-hsmmc = <0x17>;
			cdns,phy-dll-delay-strobe = <0x12>;
			fixed-emmc-driver-type = <0x04>;
			clocks = <0x05 0x09>;
			clock-names = "cardclk";
		};

		sdhc@4940000 {
			compatible = "axera,sdhc-ax620";
			reg = <0x4940000 0x10000>;
			interrupts = <0x00 0x82 0x04>;
			#address-cells = <0x01>;
			#size-cells = <0x02>;
			status = "disable";
			sdhci-caps-mask = <0x07 0x200000>;
			bus-width = <0x04>;
			max-frequency = <0xbebc200>;
			cap-sd-highspeed;
			sd-uhs-sdr25;
			sd-uhs-sdr12;
			sd-uhs-sdr50;
			sd-uhs-sdr104;
			no-sdio;
			no-mmc;
			disable-wp;
			cdns,phy-input-delay-sd-highspeed = <0x02>;
			cdns,phy-input-delay-legacy = <0x04>;
			cdns,phy-input-delay-sd-uhs-sdr12 = <0x01>;
			cdns,phy-input-delay-sd-uhs-sdr25 = <0x02>;
			cdns,phy-input-delay-sd-uhs-sdr50 = <0x01>;
			cdns,phy-input-delay-sd-uhs-ddr50 = <0x02>;
			cdns,phy-input-delay-mmc-legacy = <0x01>;
			cdns,phy-input-delay-mmc-highspeed = <0x02>;
			cdns,phy-input-delay-mmc-ddr = <0x02>;
			cdns,phy-dll-delay-sdclk = <0x00>;
			cdns,phy-dll-delay-sdclk-hsmmc = <0x15>;
			clocks = <0x04 0x1e>;
			clock-names = "cardclk";
		};

		sdhc@4950000 {
			compatible = "axera,sdhc-ax620";
			reg = <0x4950000 0x10000>;
			interrupts = <0x00 0x84 0x04>;
			#address-cells = <0x01>;
			#size-cells = <0x02>;
			status = "okay";
			sdhci-caps-mask = <0x07 0x200000>;
			bus-width = <0x04>;
			max-frequency = <0xbebc200>;
			cap-sd-highspeed;
			no-1-8-v;
			no-sdio;
			no-mmc;
			cd-gpios = <0x06 0x02 0x00>;
			cd-inverted;
			disable-wp;
			cdns,phy-input-delay-sd-highspeed = <0x02>;
			cdns,phy-input-delay-legacy = <0x04>;
			cdns,phy-input-delay-sd-uhs-sdr12 = <0x01>;
			cdns,phy-input-delay-sd-uhs-sdr25 = <0x02>;
			cdns,phy-input-delay-sd-uhs-sdr50 = <0x01>;
			cdns,phy-input-delay-sd-uhs-ddr50 = <0x02>;
			cdns,phy-input-delay-mmc-legacy = <0x01>;
			cdns,phy-input-delay-mmc-highspeed = <0x02>;
			cdns,phy-input-delay-mmc-ddr = <0x02>;
			cdns,phy-dll-delay-sdclk = <0x15>;
			cdns,phy-dll-delay-sdclk-hsmmc = <0x15>;
			clocks = <0x04 0x1e>;
			clock-names = "cardclk";
		};

		gpio@49a8000 {
			compatible = "snps,dw-apb-gpio";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x49a8000 0x1000>;
			status = "okay";

			gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x42 0x04>;
				#gpio-cells = <0x02>;
				snps,nr-gpios = <0x20>;
				reg = <0x00>;
				phandle = <0x07>;
			};
		};

		gpio@10010000 {
			compatible = "snps,dw-apb-gpio";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x10010000 0x1000>;
			status = "okay";

			gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x0b 0x04>;
				#gpio-cells = <0x02>;
				snps,nr-gpios = <0x20>;
				reg = <0x00>;
				phandle = <0x08>;
			};
		};

		gpio@4960000 {
			compatible = "snps,dw-apb-gpio";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x4960000 0x1000>;
			status = "okay";

			gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x43 0x04>;
				snps,nr-gpios = <0x20>;
				reg = <0x00>;
				phandle = <0x06>;
			};
		};

		i2c@4980000 {
			compatible = "snps,designware-i2c";
			reg = <0x4980000 0x1000>;
			interrupts = <0x00 0x5a 0x04>;
			clock-frequency = <0x61a80>;
			clocks = <0x04 0x45>;
			clock-names = "baudclk";
			#scl-gpio = <0x07 0x11 0x00>;
			#sda-gpio = <0x07 0x12 0x00>;
			status = "okay";
		};

		i2c@4982000 {
			compatible = "snps,designware-i2c";
			reg = <0x4982000 0x1000>;
			interrupts = <0x00 0x5b 0x04>;
			clock-frequency = <0x61a80>;
			clocks = <0x04 0x44>;
			clock-names = "baudclk";
			scl-gpio = <0x07 0x13 0x00>;
			sda-gpio = <0x07 0x14 0x00>;
			status = "okay";

			es8311@19 {
				compatible = "ambarella,es8311";
				reg = <0x19>;
				#sound-dai-cells = <0x00>;
				phandle = <0x19>;
			};
		};

		i2c@4984000 {
			compatible = "snps,designware-i2c";
			reg = <0x4984000 0x1000>;
			interrupts = <0x00 0x5c 0x04>;
			clock-frequency = <0x61a80>;
			clocks = <0x04 0x43>;
			clock-names = "baudclk";
			scl-gpio = <0x06 0x0c 0x00>;
			sda-gpio = <0x06 0x0d 0x00>;
			status = "disabled";
		};

		i2c@4986000 {
			compatible = "snps,designware-i2c";
			reg = <0x4986000 0x1000>;
			interrupts = <0x00 0x5d 0x04>;
			clock-frequency = <0x61a80>;
			clocks = <0x04 0x42>;
			clock-names = "baudclk";
			scl-gpio = <0x06 0x08 0x00>;
			sda-gpio = <0x06 0x09 0x00>;
			status = "disabled";
		};

		i2c@4988000 {
			compatible = "snps,designware-i2c";
			reg = <0x4988000 0x1000>;
			interrupts = <0x00 0x5e 0x04>;
			clock-frequency = <0x61a80>;
			clocks = <0x04 0x41>;
			clock-names = "baudclk";
			scl-gpio = <0x06 0x0a 0x00>;
			sda-gpio = <0x06 0x0b 0x00>;
			status = "disabled";
		};

		i2c@498a000 {
			compatible = "snps,designware-i2c";
			reg = <0x498a000 0x1000>;
			interrupts = <0x00 0x5f 0x04>;
			clock-frequency = <0x61a80>;
			clocks = <0x04 0x40>;
			clock-names = "baudclk";
			scl-gpio = <0x08 0x1b 0x00>;
			sda-gpio = <0x08 0x1c 0x00>;
			status = "disabled";
		};

		i2c@49b0000 {
			compatible = "snps,designware-i2c";
			reg = <0x49b0000 0x1000>;
			interrupts = <0x00 0x60 0x04>;
			clock-frequency = <0x61a80>;
			clocks = <0x04 0x3f>;
			clock-names = "baudclk";
			scl-gpio = <0x06 0x0e 0x00>;
			sda-gpio = <0x06 0x0f 0x00>;
			status = "okay";
		};

		i2c@49b2000 {
			compatible = "snps,designware-i2c";
			reg = <0x49b2000 0x1000>;
			interrupts = <0x00 0x61 0x04>;
			clock-frequency = <0x61a80>;
			clocks = <0x04 0x3e>;
			clock-names = "baudclk";
			scl-gpio = <0x07 0x1e 0x00>;
			sda-gpio = <0x07 0x1d 0x00>;
			status = "disabled";
		};

		i2c@49b4000 {
			compatible = "snps,designware-i2c";
			reg = <0x49b4000 0x1000>;
			interrupts = <0x00 0x62 0x04>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-frequency = <0x61a80>;
			clocks = <0x04 0x3d>;
			clock-names = "baudclk";
			status = "okay";
			scl-gpio = <0x07 0x15 0x00>;
			sda-gpio = <0x07 0x16 0x00>;

			expander_io@0x20 {
				compatible = "axera,pcal6416a";
				reg = <0x20>;
				interrput-parent = <0x01>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				status = "okay";
				phandle = <0x14>;
			};

			pt7c4563@51 {
				compatible = "diodes,pt7c4563";
				reg = <0x51>;
				status = "disable";
			};
		};

		i2c@49b6000 {
			compatible = "snps,designware-i2c";
