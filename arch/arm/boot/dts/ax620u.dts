	dsi@4490000 {
		compatible = "axera,dsi";
		status = "okay";
		enable-dsi = <0x01>;
		reg = <0x4490000 0x1000 0x44a0000 0x1000>;
		clocks = <0x10 0x0a 0x10 0x11 0x10 0x09 0x10 0x10>;
