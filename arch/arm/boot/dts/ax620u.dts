	usb@0x4800000 {
		compatible = "cdns,usb3";
		clocks = <0x04 0x6e 0x04 0x49 0x04 0x1b 0x04 0x1c 0x04 0x1d 0x04 0x1f 0x04 0x20>;
		clock-names = "usb_pclk", "usb_aclk", "usb_ref_clk", "usb2phy_clk", "stb_predft_clk", "otg_fast_clk", "lpm_predft_clk";
		interrupts = <0x00 0x6a 0x04 0x00 0x72 0x04 0x00 0x69 0x04>;
		interrupt-names = "host", "peripheral", "otg";
		reg = <0x4800000 0x10000 0x4810000 0x10000 0x4820000 0x10000>;
		reg-names = "otg", "xhci", "dev";
		maximum-speed = "high-speed";
		dr_mode = "host";
	};

	rtc-top@10040000 {
		compatible = "axera,axi-top-rtc";
		reg-num = <0x02>;
		reg = <0x10040000 0x2000 0x2210000 0x100>;
		interrupts = <0x00 0x88 0x04>;
		status = "okay";
	};

	sound {
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,name = "Axera Audio";
		simple-audio-card,widgets = "Microphone", "Mic Jack", "Headphone", "Headphone Jack";
		simple-audio-card,routing = "Headphone Jack", "DIFFERENTIAL OUT", "AMIC", "Mic Jack";

		simple-audio-card,dai-link@0 {
			format = "i2s";

			cpu {
				sound-dai = <0x18>;
			};

			codec {
				sound-dai = <0x19>;
				system-clock-frequency = <0xbb8000>;
			};
		};
	};
};
