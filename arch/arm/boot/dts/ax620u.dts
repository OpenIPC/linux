	ethernet@0x4970000 {
		compatible = "axera,dwmac-4.10a";
		reg = <0x4970000 0x10000>;
		clocks = <0x04 0x58 0x04 0x4c 0x04 0x21 0x04 0x24 0x04 0x23 0x04 0x22>;
		clock-names = "emac_pclk", "emac_aclk", "ephy_clk", "rgmii_tx_clk", "rmii_rx_clk", "rmii_tx_clk";
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x65 0x04 0x00 0x66 0x04 0x00 0x64 0x04>;
		interrupt-names = "macirq", "eth_wake_irq", "eth_lpi";
		phy-mode = "rmii";
		phy-handle = <0x16>;
		phy-rst-gpio = <0x06 0x1c 0x00>;
		rmii-phy-dir = "output";
		rx-fifo-depth = <0x4000>;
		tx-fifo-depth = <0x4000>;
		snps,tso;

		mdio {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "snps,dwmac-mdio";

			phy@1 {
				device_tpye = "ethernet-phy";
				compatible = "ethernet-phy-id001c.c816";
				reg = <0x01>;
				phandle = <0x16>;
			};
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x447fffff>;
	};

	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		ramoops_mem@43000000 {
			compatible = "ramoops";
			reg = <0x43000000 0x20000>;
			record-size = <0x20000>;
		};

		ax_memory_dump@44100000 {
			compatible = "ax_memory_dump";
			reg = <0x44100000 0x1000>;
			size = <0x1000>;
		};
	};

	chosen {
		bootargs = "mem=72M rdinit=/linuxrc console=ttyS1,230400n8 loglevel=8 vmalloc=768M";
	};

	watchdog@49aa000 {
		compatible = "snps,dw-wdt";
		reg = <0x49aa000 0x100>;
		interrupts = <0x00 0x7b 0x04>;
		clocks = <0x04 0x1a>;
