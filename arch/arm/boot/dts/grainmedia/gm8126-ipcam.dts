/dts-v1/;

#include "gm8126.dtsi"

/ {
	model = "Grain Media GM8126 IP camera";
	compatible = "grainmedia,gm8126-ipcam", "grainmedia,gm8126";

	aliases {
		serial0 = &uart0;
		ethernet0 = &ethernet;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* assumed: the PMU's divider for it is not driven here */
	sensor_clk: clock-sensor {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x08000000>;
	};
};

&ethernet {
	status = "okay";
};

&cap0 {
	status = "okay";

	port {
		cap0_in: endpoint {
			remote-endpoint = <&sensor_out>;
			bus-width = <8>;
		};
	};
};

&h264e {
	status = "okay";
};

&i2c0 {
	status = "okay";

	camera@21 {
		compatible = "ovti,ov7725";
		reg = <0x21>;
		clocks = <&sensor_clk>;

		port {
			sensor_out: endpoint {
				remote-endpoint = <&cap0_in>;
				bus-type = <5>;	/* parallel */
				bus-width = <8>;
			};
		};
	};
};

&sdc {
	bus-width = <4>;
	cd-inverted;		/* a micro-SD slot */
	broken-cd;		/* a change is polled for */
	disable-wp;
	status = "okay";
};

&spi0 {
	cs-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <30000000>;
		label = "nor-flash";
	};
};

&uart0 {
	status = "okay";
};
