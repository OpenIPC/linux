// SPDX-License-Identifier: GPL-2.0
/*
 * Axera AX620E Xiongmai IP camera (IVG-A6 class, SPI NOR, SC450AI, internal
 * EPHY). Rebuilt from the devicetree the camera's own 5.15.73 kernel boots
 * with (FIT in the stock /boot/uImage), phandles turned back into labels
 * (Axera SDK AX620E.dtsi names where the node matches). Keeping the vendor
 * nodes as they are is what lets the closed ax_*.ko media modules (axera,cmm,
 * axera,npu, axera, venc-encoder, ...) probe as on the stock firmware.
 *
 * Boot: no ATF on the NOR camera, CPU1 is released through the vendor
 * spin-table; U-Boot provides bootargs (mem= osmem, mtdparts on spi4.0).
 */

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Axera AX620E Xiongmai IPC";
	compatible = "axera,ax620e";
	interrupt-parent = <&gic>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	cpu_opp_table: cpu_opp_table {
		compatible = "operating-points-v2";
		opp-shared;

		opp00 {
			opp-hz = <0x00 0x16e3600>;
		};

		opp01 {
			opp-hz = <0x00 0xc65d400>;
		};

		opp02 {
			opp-hz = <0x00 0x1dcd6500>;
		};

		opp03 {
			opp-hz = <0x00 0x2faf0800>;
		};

		opp04 {
			opp-hz = <0x00 0x47868c00>;
		};
	};

