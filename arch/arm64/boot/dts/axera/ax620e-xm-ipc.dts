	aliases {
		ethernet0 = "/soc/ethernet@104C0000";
		serial0 = "/soc/ax_uart@4880000";
		serial1 = "/soc/ax_uart@4881000";
		serial2 = "/soc/ax_uart@4882000";
		serial3 = "/soc/ax_uart@6080000";
		serial4 = "/soc/ax_uart@6081000";
		serial5 = "/soc/ax_uart@6082000";
		spi0 = "/soc/spi@6070000";
		spi1 = "/soc/spi@6071000";
		spi2 = "/soc/spi@6072000";
		spi3 = "/soc/spi@1002E000";
		spi4 = "/soc/spi@1A00000";
		i2c0 = "/soc/i2c@4850000";
		i2c1 = "/soc/i2c@4851000";
		i2c2 = "/soc/i2c@4852000";
		i2c3 = "/soc/i2c@4853000";
		i2c4 = "/soc/i2c@4854000";
		i2c5 = "/soc/i2c@4855000";
		i2c6 = "/soc/i2c@4856000";
		i2c7 = "/soc/i2c@4857000";
		mmc0 = "/soc/sdhc@104E0000";
		mmc1 = "/soc/sdhc@1B40000";
		mmc2 = "/soc/sdhc@104D0000";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x23400dc>;
			next-level-cache = <&L2_0>;
			operating-points-v2 = <&cpu_opp_table>;
			clocks = <&cpu_clk 2>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x01>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x23400dc>;
			next-level-cache = <&L2_0>;
			operating-points-v2 = <&cpu_opp_table>;
			clocks = <&cpu_clk 2>;
		};

		L2_0: l2-cache {
			compatible = "cache";
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(2) | IRQ_TYPE_LEVEL_HIGH)>, <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(2) | IRQ_TYPE_LEVEL_HIGH)>, <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(2) | IRQ_TYPE_LEVEL_HIGH)>, <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(2) | IRQ_TYPE_LEVEL_HIGH)>;
		clock_frequency = <0x16e3600>;
	};

	gic: interrupt-controller@0x1850000 {
		compatible = "arm,gic-400";
		#interrupt-cells = <0x03>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		interrupt-controller;
		reg = <0x00 0x1851000 0x00 0x1000 0x00 0x1852000 0x00 0x1000 0x00 0x1854000 0x00 0x2000 0x00 0x1856000 0x00 0x2000>;
	};

	arm-pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <GIC_SPI 1 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu0>, <&cpu1>;
	};

	soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		ddr_sys_reset@210000 {
			compatible = "axera,axera_reset_match", "syscon";
			reg = <0x00 0x210000 0x00 0x10000>;
			#reset-cells = <0x03>;
		};

		debug_sys_reset@1800000 {
			compatible = "axera,axera_reset_match", "syscon";
			reg = <0x00 0x1800000 0x00 0x10000>;
			#reset-cells = <0x03>;
		};

		cpu_reset: cpu_sys_reset@1900000 {
			compatible = "axera,axera_reset_match", "syscon";
			reg = <0x00 0x1900000 0x00 0x10000>;
			#reset-cells = <0x03>;
		};

		comm_reset: comm_sys_reset@2340000 {
			compatible = "axera,axera_reset_match", "syscon";
			reg = <0x00 0x2340000 0x00 0x10000>;
			#reset-cells = <0x03>;
		};

		isp_sys_reset@2500000 {
			compatible = "axera,axera_reset_match", "syscon";
			reg = <0x00 0x2500000 0x00 0x10000>;
			#reset-cells = <0x03>;
