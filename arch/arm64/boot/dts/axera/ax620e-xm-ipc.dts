				#address-cells = <0x01>;
				#size-cells = <0x00>;

				bt_dpi_out_0: endpoint@0 {
					remote-endpoint = <&endpoint>;
				};

				dsi_out: endpoint@1 {
					remote-endpoint = <&dsi_in>;
				};

				lvds_out: endpoint@2 {
					remote-endpoint = <&lvds_in>;
				};
			};
		};

		crtc@1 {
			compatible = "axera,crtc";
			id = <0x01>;
			status = "okay";

			dpu1_out: port {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				bt_dpi_out_1: endpoint@0 {
					remote-endpoint = <&endpoint_1>;
				};
			};
		};

		bt_dpi@0 {
			compatible = "axera,bt-dpi";
			reg = <0x00 0x2340000 0x00 0x10000 0x00 0x10030000 0x00 0x10000 0x00 0x4600000 0x00 0x100>;
			reg-names = "common_sys_glb", "flash_sys_glb", "disp_sys_glb";
			clocks = <&common_clk 0x7d>, <&common_clk 0x77>, <&flash_clk 0x19>, <&flash_clk 0x12>;
			clock-names = "comm_clk_1x", "comm_clk_nx", "flash_clk_1x", "flash_clk_nx";
			resets = <&comm_reset 0x1a 0x54 1>, <&comm_reset 0x1b 0x54 1>, <&flash_reset 0x1a 0x14 1>, <&flash_reset 0x1b 0x14 1>;
			reset-names = "cm_dpu_1x_rst", "cm_dpu_nx_rst", "flash_dpu_1x_rst", "flash_dpu_nx_rst";
			id = <0x00>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";

			port {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				endpoint_0: endpoint@0 {
					remote-endpoint = <&panel_in_0>;
				};

				endpoint: endpoint@1 {
					remote-endpoint = <&bt_dpi_out_0>;
				};
			};
		};

		bt_dpi@1 {
			compatible = "axera,bt-dpi";
			reg = <0x00 0x2340000 0x00 0x10000 0x00 0x10030000 0x00 0x10000 0x00 0x4600000 0x00 0x100>;
			reg-names = "common_sys_glb", "flash_sys_glb";
			clocks = <&common_clk 0x7c>, <&common_clk 0x76>, <&flash_clk 0x19>, <&flash_clk 0x12>;
			clock-names = "comm_clk_1x", "comm_clk_nx", "flash_clk_1x", "flash_clk_nx";
			resets = <&comm_reset 0x1c 0x54 1>, <&comm_reset 0x1d 0x54 1>, <&flash_reset 0x1a 0x14 1>, <&flash_reset 0x1b 0x14 1>;
			reset-names = "cm_dpu_1x_rst", "cm_dpu_nx_rst", "flash_dpu_1x_rst", "flash_dpu_nx_rst";
			id = <0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";

			port {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				endpoint_0_2: endpoint@0 {
					remote-endpoint = <&endpoint_1_2>;
				};

				endpoint_1: endpoint@1 {
					remote-endpoint = <&bt_dpi_out_1>;
				};
			};
		};

		dsi@4620000 {
			compatible = "axera,dsi";
			reg = <0x00 0x4620000 0x00 0x10000 0x00 0x4600000 0x00 0x10000 0x00 0x23f1000 0x00 0x1000 0x00 0x2340000 0x00 0x10000>;
			reg-names = "dsi", "dispc_sys_glb", "dphytx_glb", "common_sys_glb";
			clocks = <&dispc_clk 5>, <&dispc_clk 7>, <&dispc_clk 8>, <&dispc_clk 2>, <&dispc_clk 3>, <&dispc_clk 0xb>, <&common_clk 0x79>;
			clock-names = "dsi_pclk", "dsi_txesc_clk", "dsi_sys_clk", "dphy_ref_clk", "dphy_esc_clk", "dphy_hs_clk", "comm_dphytx_tlb_clk";
			resets = <&dispc_reset 0xc 0xc 1>, <&dispc_reset 0xa 0xc 1>, <&dispc_reset 9 0xc 1>, <&dispc_reset 8 0xc 1>, <&dispc_reset 6 0xc 1>, <&dispc_reset 3 0xc 1>;
			reset-names = "dispc_dsi_prst", "dispc_txpix_rst", "dispc_txesc_rst", "dispc_sys_rst", "dispc_dphytx_rst", "dispc_dphy2dsi_rst";
			max-lanes = <0x04>;
			interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					dsi_output: endpoint {
						remote-endpoint = <&dsi_panel_input>;
					};
				};

				port@1 {
					reg = <0x01>;

					dsi_in: endpoint {
						remote-endpoint = <&dsi_out>;
					};
				};
			};

			panel_dsi@0 {
				compatible = "axera,simple-dsi-panel";
				reg = <0x00>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						dsi_panel_input: endpoint {
							remote-endpoint = <&dsi_output>;
						};
					};
				};
			};
		};

		lvds@4630000 {
			compatible = "axera,lvds";
			status = "disabled";
			reg = <0x00 0x4630000 0x00 0x10000 0x00 0x23f1000 0x00 0x1000 0x00 0x2340000 0x00 0x10000 0x00 0x4600000 0x00 0x10000>;
			reg-names = "lvdstx", "dphytx", "common_sys_glb", "dispc_sys_glb";
			clocks = <&dispc_clk 4>, <&dispc_clk 9>, <&dispc_clk 0xa>, <&dispc_clk 2>, <&common_clk 0x79>;
			clock-names = "lvds_p_clk", "dphytx_pll_div7_clk", "dphytx_pll_clk", "dphytx_ref_clk", "comm_dphytx_tlb_clk";
			resets = <&dispc_reset 0xd 0xc 1>, <&dispc_reset 5 0xc 1>, <&dispc_reset 4 0xc 1>;
			reset-names = "lvds_p_rst", "dphytx_pll_rst", "dphytx_pll_div7_rst";
			interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					lvds_in: endpoint {
						remote-endpoint = <&lvds_out>;
					};
				};

				port@1 {
					reg = <0x01>;

					lvds_output: endpoint {
						remote-endpoint = <&lvds_panel_input>;
					};
				};
			};
		};

		panel@0 {
			compatible = "axera,simple-panel";
			id = <0x00>;
			status = "disabled";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					panel_in_0: endpoint@0 {
						remote-endpoint = <&endpoint_0>;
					};

					endpoint_1_2: endpoint@1 {
						remote-endpoint = <&endpoint_0_2>;
					};
				};
			};

			display-timings {
				timing0 {
					clock-frequency = <0x1be0b80>;
					hactive = <0x320>;
					hfront-porch = <0x28>;
					hsync-len = <0x30>;
					hback-porch = <0x28>;
					vactive = <0x1e0>;
					vfront-porch = <0x0d>;
					vsync-len = <0x03>;
					vback-porch = <0x1d>;
					hsync-active = <0x01>;
					vsync-active = <0x01>;
					de-active = <0x01>;
				};
			};
		};

		panel_lvds@0 {
			compatible = "axera,lvds-panel";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					lvds_panel_input: endpoint {
						remote-endpoint = <&lvds_output>;
					};
				};
			};
		};

		gzipd@10410000 {
			compatible = "axera,ax_gzipd";
			reg = <0x00 0x10410000 0x00 0x10000>;
			reg-names = "reg_gzipd";
			interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
			status = "okay";
			clocks = <&flash_clk 0x23>, <&flash_clk 0x13>;
			clock-names = "gzipd_clk", "gzipd_core_clk";
			resets = <&flash_reset 0xa 0x14 1>, <&flash_reset 0xb 0x14 1>;
			reset-names = "gzipd_rst", "gzipd_core_rst";
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x40000000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		ramoops_mem@41000000 {
			compatible = "ramoops";
			reg = <0x00 0x41000000 0x00 0x8000>;
			record-size = <0x4000>;
			console-size = <0x4000>;
		};
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	sound {
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,name = "Axera Audio";
		simple-audio-card,widgets = "Microphone", "Mic Jack";
		simple-audio-card,routing = "AMIC", "Mic Jack";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		simple-audio-card,dai-link@0 {
			format = "i2s";
			bitclock-master = <&codec_m6>;
			frame-master = <&codec_m6>;

			cpu {
				sound-dai = <&i2s_inner_slv0>;
			};

			codec_m6: codec {
				sound-dai = <&audio_codec>;
				system-clock-frequency = <0xbb8000>;
			};
		};

		simple-audio-card,dai-link@1 {
			format = "i2s";

			cpu {
				sound-dai = <&i2s_inner_mst0>;
			};

			codec {
				sound-dai = <&audio_codec>;
				system-clock-frequency = <0xbb8000>;
			};
		};
	};

	axera_logctl {
		compatible = "axera,logctl";
		config = "/mnt/mtd/ax_syslog.conf";
		logstate = [01 01];
		loglevel = [04 04];
	};

	extcon_usb: extcon_usb {
		compatible = "linux,extcon-usb-gpio";
		id-gpio = <&ax_gpio1 2 0>;
		status = "disabled";
	};
};
