		ax_uart@4880000 {
			compatible = "axera,ax-apb-uart";
			reg = <0x00 0x4880000 0x00 0x400>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			resets = <&periph_reset 0x15 0x20 1>, <&periph_reset 0x14 0x20 1>;
			reset-names = "reset", "preset";
			clocks = <&periph_clk 0x5c>, <&periph_clk 0x69>;
			clock-names = "baudclk", "apb_pclk";
			interrupts = <GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>;
			default_cpr_reg = <0x425f2>;
			status = "okay";
		};

		ax_uart@4881000 {
			compatible = "axera,ax-apb-uart";
			reg = <0x00 0x4881000 0x00 0x400>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			dmas = <&dma_per 0x2a>, <&dma_per 0x2b>;
			dma-names = "tx", "rx";
