		cpu_clk: cpu_clk@1900000 {
			compatible = "axera,ax620x-cpu-clk", "syscon";
			reg = <0x00 0x1900000 0x00 0x10000>;
			#clock-cells = <0x01>;
		};

		common_clk: common_clk@2340000 {
			compatible = "axera,ax620x-common-clk", "syscon";
			reg = <0x00 0x2340000 0x00 0x10000>;
			#clock-cells = <0x01>;
		};

		dispc_clk: dispc_clk@4600000 {
			compatible = "axera,ax620x-dispc-clk", "syscon";
			reg = <0x00 0x4600000 0x00 0x10000>;
			#clock-cells = <0x01>;
		};

		flash_clk: flash_clk@10030000 {
			compatible = "axera,ax620x-flash-clk", "syscon";
			reg = <0x00 0x10030000 0x00 0x10000>;
			#clock-cells = <0x01>;
		};

		isp_clk@2500000 {
			compatible = "axera,ax620x-isp-clk", "syscon";
			reg = <0x00 0x2500000 0x00 0x10000>;
			#clock-cells = <0x01>;
