config COMMON_CLK_HI3520DV100
	bool "Hi3520D V100 Clock and Reset Driver"
	depends on ARCH_HISI || ARCH_HISI_BVT || COMPILE_TEST
	select RESET_HISI
	help
	  Build the clock and reset driver for the CRG and the system
	  controller clocks of the HiSilicon Hi3520D V100 (and the Hi3515A and
	  Hi3515C of the same data sheet). It provides the bus clock, the
	  peripheral clock gates and selects, the SP804 and SP805 count clock
	  selects and the peripheral soft resets. The SP804 timers need it,
	  so it is built in. Hi3520D V200 kernels select it as well, but their
	  device trees do not use it.

config COMMON_CLK_HI3516CV300
	bool "Hi3516C V300 / Hi3516E V100 Clock and Reset Driver"
	depends on ARCH_HISI || ARCH_HISI_BVT || COMPILE_TEST
	select RESET_HISI
	default ARCH_HI3516CV300
	help
	  Build the clock and reset driver for the CRG and the system
	  controller clocks of the Hi3516C V300 and the Hi3516E V100.
	  The SP804 timer is probed before the platform drivers, so the
	  clocks are registered early and the driver cannot be a module.

config COMMON_CLK_HI3516CV200
	bool "Hi3516C V200 / Hi3518E V20x Clock and Reset Driver"
	depends on ARCH_HISI || ARCH_HISI_BVT || COMPILE_TEST
	select RESET_HISI
	default ARCH_HI3516CV200
	help
	  Build the clock and reset driver for the CRG and the system
	  controller clocks of the Hi3516C V200 and Hi3518E V200/V201.
	  The SP804 timer is probed before the platform drivers, so the
	  clocks are registered early and the driver cannot be a module.

config COMMON_CLK_HI3536DV100
	bool "Hi3536D V100 / Hi3536E Clock and Reset Driver"
	depends on ARCH_HISI || ARCH_HISI_BVT || COMPILE_TEST
	select RESET_HISI
	default ARCH_HI3536DV100
	help
	  Build the clock and reset driver for the CRG and the system
	  controller clocks of the HiSilicon Hi3536D V100 and the Hi3536E.
	  The SP804 timer is the only tick source of these SoCs and is
	  probed before the platform drivers, so the clocks are registered
	  early and the driver cannot be a module.

config COMMON_CLK_HI3516AV100
	tristate "HI3516AV100 / Hi3516DV100 Clock Driver"
	depends on ARCH_HISI || ARCH_HISI_BVT || COMPILE_TEST
	select RESET_HISI
	default ARCH_HI3516AV100
	help
	  Build the clock driver for the V2A family — hi3516av100 and
	  the pin-compatible hi3516dv100 (Cortex-A7 / ARMv7). Ports the
	  vendor Hi3516A_SDK_V1.0.8.0 BSP clock topology onto the modern
	  crg- platform_driver scaffold. APLL programming is stubbed —
	  the CPU runs at the U-Boot-configured rate.

