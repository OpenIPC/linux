config COMMON_CLK_HI3520DV100
	bool "Hi3520D V100 Clock and Reset Driver"
	depends on ARCH_HISI || ARCH_HISI_BVT || COMPILE_TEST
	select RESET_HISI
	default ARCH_HI3520DV200
	help
	  Build the clock and reset driver for the CRG and the system
	  controller clocks of the HiSilicon Hi3520D V100 (and the Hi3515A and
	  Hi3515C of the same data sheet). It provides the bus clock, the
	  peripheral clock gates and selects, the SP804 and SP805 count clock
	  selects and the peripheral soft resets. The SP804 timers need it,
	  so it is built in. It is not used by Hi3520D V200 device trees.

config COMMON_CLK_HI3516CV300
	tristate "HI3516CV300 Clock Driver"
	depends on ARCH_HISI || ARCH_HISI_BVT || COMPILE_TEST
	select RESET_HISI
	default ARCH_HISI
	help
	  Build the clock driver for hi3516cv300.

config COMMON_CLK_HI3516CV200
	tristate "HI3516CV200 / Hi3518EV20x Clock Driver"
	depends on ARCH_HISI || ARCH_HISI_BVT || COMPILE_TEST
	select RESET_HISI
	default ARCH_HI3516CV200
	help
	  Build the clock driver for the V2 family — hi3516cv200,
	  hi3518ev200, hi3518ev201. Ports the vendor 4.9 BSP clock
	  topology onto the modern crg- platform_driver scaffold.

config COMMON_CLK_HI3516AV100
	tristate "HI3516AV100 / Hi3516DV100 Clock Driver"
	depends on ARCH_HISI || ARCH_HISI_BVT || COMPILE_TEST
	select RESET_HISI
	default ARCH_HI3516AV100
	help
	  Build the clock driver for the V2A family — hi3516av100 and
	  the pin-compatible hi3516dv100 (Cortex-A7 / ARMv7). Ports the
	  vendor Hi3516A_SDK_V1.0.8.0 BSP clock topology onto the modern
	  crg- platform_driver scaffold. APLL programming is stubbed —
	  the CPU runs at the U-Boot-configured rate.

