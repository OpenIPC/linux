config COMMON_CLK_AXERA
	bool
	help
	  Axera SoCs' clock support.

config COMMON_CLK_AX620E
	bool "Clock driver for Axera AX620E"
	depends on ARCH_AXERA || COMPILE_TEST
	select COMMON_CLK_AXERA
	default ARCH_AXERA
	help
	  This driver supports Axera AX620E basic clocks.


config COMMON_CLK_AX620U
	bool "Clock provider for Axera AX620U (axera,ax620x)"
	depends on ARCH_AXERA || COMPILE_TEST
	help
	  Clock provider for the AX620U ("axera,ax620x") camera SoC, a
	  different die from AX620E with its own clock register map. Every
	  clock index of its nine syscon clock blocks resolves to a
	  fixed-rate, always-on clock (rate from "axera,stub-rate" on the
	  block, default 24 MHz): the hardware is left exactly as the
	  bootloader configured it, gating and rate changes are no-ops.
	  Say N to COMMON_CLK_AX620E when enabling this, both bind the
	  same compatibles.
