config COMMON_CLK_AXERA
	bool
	help
	  Axera SoCs' clock support.

config COMMON_CLK_AX620E
	bool "Clock driver for Axera AX620E"
	depends on ARCH_AXERA || COMPILE_TEST
	depends on !COMMON_CLK_AX620U
	select COMMON_CLK_AXERA
	default ARCH_AXERA
	help
	  This driver supports Axera AX620E basic clocks.


config COMMON_CLK_AX620U
	bool "Clock driver for Axera AX620U (axera,ax620x)"
	depends on ARCH_AXERA || COMPILE_TEST
	select COMMON_CLK_AXERA
	help
	  Clock driver for the AX620U ("axera,ax620x") camera SoC, a
	  different die from AX620E with its own clock register map: the
	  muxes, gates and dividers of its eight syscon clock blocks, with
	  the stock AX620U kernel's clock names and IDs. The PLLs are
	  fixed-rate, as the first stage programs them. It binds the same
	  compatibles as COMMON_CLK_AX620E, which it therefore excludes.
