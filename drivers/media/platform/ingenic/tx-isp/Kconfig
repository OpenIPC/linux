config VIDEO_INGENIC_ISP
	tristate "Ingenic T23 Image Signal Processor (ISP) driver"
	depends on V4L_PLATFORM_DRIVERS
	depends on VIDEO_DEV && VIDEO_V4L2_SUBDEV_API && MEDIA_CONTROLLER
	depends on MACH_INGENIC || COMPILE_TEST
	depends on OF && HAS_DMA
	select VIDEOBUF2_V4L2
	select VIDEOBUF2_DMA_CONTIG
	select VIDEOBUF2_VMALLOC
	select V4L2_FWNODE
	help
	  Say yes or m here to build V4L2 support for the Ingenic T23 VIC,
	  CSI-2 receiver, ISP core, MSCA scaler, motion detector, and OSD
	  overlay pipeline.

	  To compile this driver as a module, choose M here: the module
	  will be called tx-isp.
