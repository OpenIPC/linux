config VIDEO_INGENIC_IPU
	tristate "Ingenic T23 IPU v13 V4L2 M2M image processor"
	depends on V4L_MEM2MEM_DRIVERS
	depends on VIDEO_DEV
	depends on MACH_INGENIC || COMPILE_TEST
	depends on OF && HAS_DMA
	select VIDEOBUF2_DMA_CONTIG
	select V4L2_MEM2MEM_DEV
	help
	  V4L2 memory-to-memory NV12/NV21 and RGB format conversion and
	  crop/compose driver for Ingenic T23 IPU v13 hardware.

	  To compile this driver as a module, choose M here: the module
	  will be called ingenic-ipu.
