config VIDEO_HISI_JPGE
	tristate "HiSilicon JPEG encoder (JPGE) mem2mem driver"
	depends on V4L_MEM2MEM_DRIVERS
	depends on VIDEO_DEV
	depends on ARCH_HISI_BVT || COMPILE_TEST
	depends on OF
	depends on PM
	select VIDEOBUF2_DMA_CONTIG
	select V4L2_MEM2MEM_DEV
	select V4L2_JPEG_HELPER
	help
	  Support for the baseline JPEG encoder (JPGE) found in the
	  HiSilicon Hi3520D V100 and Hi3536D V100 video SoCs. The driver is a
	  V4L2 memory-to-memory device: raw YCbCr frames go in, JPEG files
	  come out.

	  To compile this driver as a module, choose M here: the module
	  will be called hisi-jpge.
