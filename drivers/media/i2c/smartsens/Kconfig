config VIDEO_SC1346
	tristate "SmartSens SC1346 sensor support"
	depends on I2C && VIDEO_DEV && OF
	select MEDIA_CONTROLLER
	select VIDEO_V4L2_SUBDEV_API
	select V4L2_FWNODE
	select VIDEO_SMARTSENS_COMMON
	help
	  Say Y here to enable the V4L2 driver for the SmartSens SC1346
	  1280x720 CMOS image sensor with a MIPI CSI-2 interface.

	  To build this driver as a module, choose M here. The module
	  will be called sensor_sc1346.

